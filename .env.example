# 复制为 .env 后填写。模型、提供方、密钥都从这里读，代码里不写死。

# 本机数据目录：原始素材、派生文件、SQLite 数据库都放这里
DATA_DIR=./data
DATABASE_URL=file:./data/qingqing.db

# 文字生成：anthropic | openai | qwen | fake（fake 用于开发和测试，不调用网络）
# 用户定的：文字处理统一用 DeepSeek → AI_PROVIDER=openai、AI_MODEL=deepseek-chat、OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER=fake
AI_MODEL=
# 仅 anthropic：low | medium | high | xhigh | max，不填用模型默认值
AI_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
# DeepSeek 等兼容 OpenAI 接口的服务：AI_PROVIDER=openai，AI_MODEL=deepseek-chat，再填下面这行和 OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 润色分块大小（字），默认 800
# POLISH_CHUNK_CHARS=800
# 润色单独用的模型（同一个提供方）。实测 DeepSeek 的推理模型润色明显更像作者认可的版本，但每 800 字要半分钟左右
POLISH_MODEL=deepseek-reasoner

# 固定某个提示词版本（默认用 prompts/ 里最新的），例如：
# PROMPT_LONGFORM=v1

# 中文语音识别（需要逐字时间戳）：volcengine | fake
ASR_PROVIDER=fake
# 火山引擎 · 豆包语音「大模型录音文件识别」极速版（控制台里的 App ID 和 Access Token）
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_KEY=
# 可选：默认 volc.bigasr.auc_turbo
VOLC_ASR_RESOURCE_ID=

# 烧进画面的字幕用什么字体（系统里装了的字体名），默认 Microsoft YaHei
SUBTITLE_FONT=

# 可选：ffmpeg / ffprobe 不在 PATH 里时指定路径
FFMPEG_PATH=
FFPROBE_PATH=
